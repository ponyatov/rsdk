#!/bin/sh
MAX=200M
SWAP=100M

## 'MT27800 Family [ConnectX-5] 1017'
## if=enp1s0np1 drv=mlx5_core unused=igb_uio,vfio-pci,uio_pci_generic
ETH=ens1f0np0
PCI=0000:08:00.0
SIP=10.120.1.11/24
# RECV=ens3f0np0 // 10.120.1.111

DRIVER=vfio-pci
# HUGESIZE=2048
HUGESIZE=4096

DPDK_VERSION=24.11.3
DPDK_ROOT=/usr/local
DEVBIND=$DPDK_ROOT/bin/dpdk-devbind.py
