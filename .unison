# .unison
## ln -fs ~/rsdk/.unison ~/.unison/rsdk.prf

# Название профиля (опционально)
label = rsdk sync

# Корневые директории
root = /home/dponyatov/rsdk
root = ssh://dimon@10.110.1.101//home/dimon/rsdk

# Автоматизация
auto   = true
batch  = true
prefer = newer

# Игнорирование специфичных файлов и кэшей
# ignore = Name {.unison}
ignore = Name {.git}
ignore = Name {*~,*.log,*.sw?}
ignore = Name {bin,tmp,ref,_build,target}
ignore = Name {doc/html,lib/pcpp}
ignore = Name {node_modules,.cache}
ignore = Name {*.pyc,__pycache__}
